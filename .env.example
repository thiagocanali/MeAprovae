# PostgreSQL connection string (server only)
DATABASE_URL=

# Application environment
NODE_ENV=development

# Supabase Auth (server-side runtime config)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only canonical HTTPS origin for auth email links; required outside local development.
# Set to the deployed app's validated origin (no path/trailing slash needed).
AUTH_REDIRECT_ORIGIN=
