# PostgreSQL connection string (server only)
DATABASE_URL=

# Application environment
NODE_ENV=development
# Keep Supabase active unless a separate environment explicitly opts in to Neon.
DATABASE_PROVIDER=supabase
# Neon staging endpoints (server-only; no database credentials in public env).
NEON_AUTH_BASE_URL=
NEON_DATA_API_URL=

# Supabase Auth (server-side runtime config)
SUPABASE_URL=
SUPABASE_ANON_KEY=
